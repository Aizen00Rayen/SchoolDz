{
  "expo": {
    "name": "Scolaris Parent",
    "slug": "scolaris-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAFA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scolarisdz.parent"
    },
    "android": {
      "package": "com.scolarisdz.parent",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "1bb3ca94-be2a-4a01-ad4f-fa8c06369704"
      }
    },
    "owner": "rayenaizens-org"
  }
}
